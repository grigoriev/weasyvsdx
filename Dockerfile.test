# The test environment: WeasyPrint needs Pango and weasyvsdx needs vsd2xhtml, which macOS lacks. Run it
# through the Makefile.
#
#   make test             pytest with coverage, in the "test" stage
#   make visual           the visual regression bench, in the "visual" stage
#
# BASE selects the Python version, for example python:3.11-slim-trixie.
ARG BASE=python:3.14-slim-trixie@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170

FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM ${BASE} AS test
# Pango for WeasyPrint, the tools of libvisio, emf2svg for EMF images, and the fonts the tests assume.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 libvisio-tools emf2svg \
        fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
# The environment lives outside the mounted source, so it never clashes with a host .venv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/opt/uv-cache
WORKDIR /src
# Only the dependency files: an edit of the README must not rebuild the environment
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --all-extras --no-install-project
CMD ["uv", "run", "--frozen", "--all-extras", "pytest", "--cov", "--cov-report=term-missing", "--cov-report=xml"]

FROM test AS visual
# The fonts of the weasyprint-service image, and LibreOffice Draw, which makes the references in this same
# image. The service converted Visio drawings with LibreOffice before.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        fonts-dejavu fonts-freefont-ttf fonts-ipafont-gothic fonts-noto-cjk fonts-noto-color-emoji \
        fonts-tlwg-loma-otf fonts-unifont fonts-wqy-zenhei \
        libreoffice-draw-nogui \
    && rm -rf /var/lib/apt/lists/*
CMD ["uv", "run", "--frozen", "--all-extras", "python", "tools/visual/bench.py"]
