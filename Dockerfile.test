# The test environment: WeasyPrint needs Pango and weasyvsdx needs vsd2xhtml, which macOS lacks. Run it
# through the Makefile.
#
#   make test             pytest with coverage, in the "test" stage
#   make visual           the visual regression bench, in the "visual" stage
#
# BASE selects the Python version, for example python:3.11-slim-trixie.
ARG BASE=python:3.15-slim-trixie@sha256:533b0b2f9b5d46fd097091cf826f27902f1d6c3bca714b6dc74551356aa97a51

FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM ${BASE} AS test
# Pango for WeasyPrint, the tools of libvisio, emf2svg for EMF images, and the fonts the tests assume.
# LIBVISIO is the release weasyvsdx is tested with: 0.1.7 of trixie, or 0.1.11 of Debian testing, which only
# libvisio-tools comes from. Another release fails here.
ARG LIBVISIO=0.1.7
RUN if [ "$LIBVISIO" != 0.1.7 ]; then \
        echo 'deb http://deb.debian.org/debian testing main' > /etc/apt/sources.list.d/testing.list \
        && printf 'Package: *\nPin: release a=testing\nPin-Priority: 100\n' > /etc/apt/preferences.d/testing; \
    fi \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 libvisio-tools emf2svg \
        fonts-dejavu-core fonts-liberation \
    && if [ "$LIBVISIO" != 0.1.7 ]; then apt-get install --yes --no-install-recommends --target-release testing libvisio-tools; fi \
    && test "$(vsd2xhtml --version)" = "vsd2xhtml $LIBVISIO" \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
# The environment lives outside the mounted source, so it never clashes with a host .venv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/opt/uv-cache
WORKDIR /src
# Only the dependency files: an edit of the README must not rebuild the environment
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --all-extras --no-install-project
CMD ["uv", "run", "--frozen", "--all-extras", "pytest", "--cov", "--cov-report=term-missing", "--cov-report=xml"]

FROM test AS visual
# The fonts of the weasyprint-service image with the replacements of Calibri and Cambria, and LibreOffice
# Draw, which makes the references in this same image. The service converted Visio drawings with
# LibreOffice before. rsvg-convert rasterizes the SVGs that Visio exported of the Azure diagrams.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        fonts-dejavu fonts-freefont-ttf fonts-ipafont-gothic fonts-noto-cjk fonts-noto-color-emoji \
        fonts-tlwg-loma-otf fonts-unifont fonts-wqy-zenhei \
        fonts-crosextra-carlito fonts-crosextra-caladea \
        libreoffice-draw-nogui librsvg2-bin \
    && rm -rf /var/lib/apt/lists/*
# Selawik, the open fallback Microsoft made for Segoe UI, which the Azure diagrams ask for. Debian has no
# package of it: the release of microsoft/Selawik, checked by its SHA-256.
ADD --checksum=sha256:3f62c51e05e3b5a1e6241cf92a371f0be2ea1183aa87b30718bbd40832a8d423 \
    https://github.com/microsoft/Selawik/releases/download/1.01/Selawik_Release.zip /tmp/selawik.zip
RUN python -c "import zipfile; zipfile.ZipFile('/tmp/selawik.zip').extractall('/usr/local/share/fonts/selawik')" \
    && rm /tmp/selawik.zip \
    && fc-cache --force \
    && test -n "$(fc-list Selawik)" && test -n "$(fc-list Carlito)"
CMD ["uv", "run", "--frozen", "--all-extras", "python", "tools/visual/bench.py"]
